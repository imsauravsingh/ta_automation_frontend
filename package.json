{
  "name": "ta-automation-frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:recruiter": "pnpm --filter @app/recruiter-dashboard dev",
    "dev:admin": "pnpm --filter @app/admin-console dev",
    "dev:analytics": "pnpm --filter @app/analytics-view dev",
    "build": "pnpm -w run build",
    "lint": "pnpm -w run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -w run test",
    "clean": "pnpm -w run clean",
    "type-check": "pnpm -w run type-check"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.33",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  }
}
